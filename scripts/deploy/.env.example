# Copy to scripts/deploy/.env.dev or scripts/deploy/.env.prod (gitignored).
# apps/api/.env is also sourced for DATABASE_URL during backup/migrate.

# API (Hetzner VPS via SSH + rsync)
DEPLOY_API_SSH=deploy@api.dev.example.com
DEPLOY_API_PATH=/opt/doctordesk
DEPLOY_API_SERVICES="doctordesk-api doctordesk-worker"

# Web (Cloudflare Pages)
VITE_API_URL=https://api.dev.example.com/api/v1
CLOUDFLARE_PAGES_PROJECT=doctordesk-dev
CLOUDFLARE_PAGES_BRANCH=dev

# Remote DB for migrate:prod / backup:db:prod (Neon)
# REMOTE_DATABASE_URL=postgresql+asyncpg://...
